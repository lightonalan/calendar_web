<!DOCTYPE html>
<html lang="vi">
  <head>
    <title><%= content_for(:title) || "Lịch Âm — Lịch vạn niên, văn khấn & sự kiện" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'Ứng dụng lịch âm dương, giờ hoàng đạo, văn khấn truyền thống, xem quẻ và quản lý sự kiện cho người Việt.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lịch Âm">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-stone-50 text-stone-900 antialiased">
    <header class="fixed top-0 z-50 w-full border-b border-amber-100/80 bg-white/90 backdrop-blur-md">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <%= link_to root_path, class: "flex items-center gap-3 font-semibold text-amber-900" do %>
          <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-red-600 text-lg text-white shadow-md">âm</span>
          <span>Lịch Âm</span>
        <% end %>

        <div class="hidden items-center gap-8 text-sm font-medium text-stone-600 md:flex">
          <%= link_to "Tính năng", root_path(anchor: "features"), class: "hover:text-amber-700 transition" %>
          <%= link_to "Tải app", root_path(anchor: "download"), class: "hover:text-amber-700 transition" %>
          <%= link_to "Hỗ trợ", support_path, class: "hover:text-amber-700 transition" %>
          <%= link_to "Bảo mật", privacy_path, class: "hover:text-amber-700 transition" %>
        </div>

        <%= link_to "Tải miễn phí", root_path(anchor: "download"),
            class: "rounded-full bg-amber-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-700 transition" %>
      </nav>
    </header>

    <main>
      <%= yield %>
    </main>

    <footer class="border-t border-stone-200 bg-white">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-3">
        <div>
          <p class="text-lg font-semibold text-amber-900">Lịch Âm</p>
          <p class="mt-3 text-sm leading-relaxed text-stone-600">
            Lịch vạn niên trên điện thoại — xem ngày âm dương, giờ hoàng đạo, văn khấn và sự kiện quan trọng mỗi ngày.
          </p>
        </div>

        <div>
          <p class="font-semibold text-stone-800">Liên kết</p>
          <ul class="mt-3 space-y-2 text-sm text-stone-600">
            <li><%= link_to "Trang chủ", root_path, class: "hover:text-amber-700" %></li>
            <li><%= link_to "Hỗ trợ", support_path, class: "hover:text-amber-700" %></li>
            <li><%= link_to "Chính sách bảo mật", privacy_path, class: "hover:text-amber-700" %></li>
            <li><%= link_to "Điều khoản sử dụng", terms_path, class: "hover:text-amber-700" %></li>
          </ul>
        </div>

        <div>
          <p class="font-semibold text-stone-800">Tải ứng dụng</p>
          <ul class="mt-3 space-y-2 text-sm text-stone-600">
            <li>
              <a href="https://play.google.com/store/apps/details?id=com.lighton.calendar" target="_blank" rel="noopener" class="hover:text-amber-700">
                Google Play
              </a>
            </li>
            <li><span class="text-stone-400">App Store — sắp ra mắt</span></li>
          </ul>
          <p class="mt-4 text-xs text-stone-400">© <%= Date.current.year %> Lighton. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
